{
    "name": "@voltlabs/registry",
    "version": "0.1.0",
    "private": true,
    "description": "Public package registry backing registry.voltcloud.dev",
    "license": "UNLICENSED",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "typecheck": "tsc --noEmit",
        "migrate:legacy": "tsx scripts/import-legacy-index.ts",
        "seed:samples": "tsx scripts/seed-sample-packages.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.700.0",
        "@aws-sdk/s3-request-presigner": "3.700.0",
        "cors": "2.8.5",
        "dotenv": "16.4.5",
        "express": "4.21.2",
        "helmet": "8.0.0",
        "jose": "5.9.6",
        "mongoose": "8.8.4",
        "multer": "1.4.5-lts.1",
        "pino": "9.5.0",
        "pino-http": "10.3.0",
        "semver": "7.6.3",
        "undici": "6.21.0",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@types/cors": "2.8.17",
        "@types/express": "4.17.21",
        "@types/multer": "1.4.12",
        "@types/node": "20.17.9",
        "@types/semver": "7.5.8",
        "tsc-alias": "1.8.10",
        "tsx": "4.19.2",
        "typescript": "5.5.4"
    }
}
