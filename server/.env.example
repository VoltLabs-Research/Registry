PORT=8082
NODE_ENV=development

MONGO_URL=mongodb://mongo:27017/volt-registry

RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=voltadmin
RUSTFS_SECRET_KEY=voltadminsecret
RUSTFS_TARBALL_BUCKET=vpm-tarballs
RUSTFS_README_BUCKET=vpm-readmes

CONSOLE_URL=http://console:8081
CONSOLE_SERVICE_TOKEN=replace-with-shared-secret
CONSOLE_JWKS_URL=http://console:8081/.well-known/jwks.json

CORS_ORIGINS=https://voltcloud.dev,https://console.voltcloud.dev,http://localhost:5173

SYSTEM_ACCOUNT_ID=000000000000000000000001
LEGACY_INDEX_URL=https://server.voltcloud.dev/plugin-registry/index.json
